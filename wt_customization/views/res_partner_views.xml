<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="youthwork_res_partner_form_view" model="ir.ui.view">
            <field name="name">res.partner_youtwork_view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <data>
                    <field name="function" position="replace"/>
                    <!-- <field name="phone" position="replace"/> -->
                    <field name="category_id" position="replace"/>
                    
                    <xpath expr="//group//field[@name='email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr="//label[@for='email']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </xpath>

                    <xpath expr="//label[@for='phone']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    
                    <xpath expr="//label[@for='mobile']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>

                    <field name="mobile" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </field>
                    
                    <field name="website" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </field>
                    
                    <field name="title" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </field>
                
                    <field name="vat" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </field>
                    
                    <field name="lang" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </field>
                    
                    <xpath expr="//span[@name='address_name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </xpath>

                    <xpath expr="//page[@name='accounting']" position="attributes">
                        <attribute name="string">Banking Details</attribute>
                    </xpath>

                    <xpath expr="//page[@name='contact_addresses']" position="attributes">
                        <attribute name="attrs">{'invisible': [('is_company','=', False)]}</attribute>
                    </xpath>
                    
                    <xpath expr="//div[hasclass('o_address_format')]" position="attributes">
                    <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr="//button[@name='create_company']"  position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <xpath expr="//field[@name='company_name']"  position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <!--<field name="email" position="replace">-->
                    <!--  <field name="email" context="{'gravatar_image': True}"/>-->
                    <!--</field>-->
                    
                    <field name="parent_id" position="replace">
                    <group>
                        <field name="dummy_field" invisible="1"/>
                        <field name="cohorts_ids" placeholder="Cohorts" widget="many2many_tags" attrs="{'invisible': [('is_company','=', False)]}" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" readonly="1"/>
                        <field name="youth_company_type" attrs="{'invisible': [('is_company','=', False)], 'required': [('is_company','=', True)]}"/>
                        <field name="youth_contact_type" attrs="{'invisible': [('is_company','=', True)]}"/>

                        <field name="parent_id" widget="res_partner_many2one" placeholder="Company Name..." domain="[('is_company', '=', True)]" context="{'default_is_company': True, 'show_vat': True, 'default_user_id': user_id}" attrs="{'invisible': ['|', '|', '&amp;', ('is_company','=', True),('parent_id', '=', False),('company_name', '!=', False),('company_name', '!=', ''), ('youth_contact_type', '=', 'Next of Kin')]}"/>

                        <field name="youth_id" string="Linked User" attrs="{'invisible': ['|', ('youth_contact_type','not in', ('Youth', 'Supervisor','Y@W Employee')), ('is_company','=', True)]}"/>
                        <field name="cohort_id"/>
                        <field name="next_of_kin_relationship" attrs="{'invisible': ['|', ('youth_contact_type','!=', 'Next of Kin'), ('is_company','=', True)]}"/>
                        <field name="host_site_id" widget="one2many_tags" attrs="{'invisible': ['|', ('is_company','=', True), ('youth_contact_type', '=', 'Next of Kin')]}"/>
                        <field name="function" placeholder="e.g. Supervisor" attrs="{'invisible': ['|', ('is_company','=', True), ('youth_contact_type', '=', 'Next of Kin')]}"/>
                        <field name="mobile" widget="phone" required="1" string="Primary Number"/>
                        <field name="phone" widget="phone" string="Secondary Number"/>
                        <field name="no_of_vaccancies" attrs="{'invisible': ['|', '|', ('is_company','=', True), ('youth_contact_type', '=', 'Next of Kin'), ('company_type', '=', 'person')]}"/>

                        <span class="o_form_label o_td_label" name="address_name">
                            <field name="type" attrs="{'invisible': [('is_company','=', True)], 'required': [('is_company','!=', True)], 'readonly': [('user_ids', '!=', [])]}" class="fw-bold"/>
                            <b attrs="{'invisible': [('is_company', '=', False)]}">Address</b>
                        </span>
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                            <field name="city" placeholder="City" class="o_address_city" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                            <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                            <div name="partner_address_country" class="d-flex justify-content-between">
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                            </div>
                        </div>
                        <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="e.g. &quot;B2B&quot;, &quot;VIP&quot;, &quot;Consulting&quot;, ..."/>
                        <field name="female_ownership" widget="percentage" digits="[16, 2]" attrs="{'invisible': [('is_company','=', False)]}"/>
                        <field name="bee_level" attrs="{'invisible': [('is_company','=', False)]}"/>
                        <field name="business_size" attrs="{'invisible': [('is_company','=', False)]}"/>
                        <field name="sector_id" attrs="{'invisible': [('is_company','=', False)]}" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>



                        <field name="next_of_kin_ids" mode="kanban" attrs="{'invisible': ['|', ('youth_contact_type','!=', 'Next of Kin'), ('is_company','=', True)]}">
                        <kanban>
                            <field name="name"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                                        <div class="oe_kanban_details">
                                            <div class="o_kanban_record_top">
                                                <div class="o_kanban_record_headings">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </strong>
                                                </div>
                                            </div>
                                            <!--<div class="oe_kanban_content">-->
                                            <!--    <div class="o_kanban_record_bottom">-->
                                            <!--        <div class="oe_kanban_bottom_left">-->
                                            <!--        </div>-->
                                            <!--        <div class="oe_kanban_bottom_right">-->
                                            <!--        </div>-->
                                            <!--    </div>-->
                                            <!--</div>-->
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <field name="website" string="Website" widget="url" placeholder="e.g. https://1stream.co.za" attrs="{'invisible': [('is_company','=', False)]}"/>
                    </group>
                    </field>
                    <xpath expr="//h1" position="after">
                        <div class="o_row">
                            <group>
                                <field name="company_name" attrs="{'invisible': ['|', '|', ('company_name', '=', False), ('company_name', '=', ''), ('is_company', '=', True)]}"/>
                            </group>
                            <button name="create_company" icon="fa-plus-square" string="Create company" type="object" class="oe_edit_only btn-link" attrs="{'invisible': ['|', '|', ('is_company','=', True), ('company_name', '=', ''), ('company_name', '=', False)]}"/>
                        </div>
                    </xpath>
                
                    <!-- <field name="function" position="replace">-->
                    <!--  <field name="youth_id" attrs="{'invisible': ['|', ('contact_type','!=', 'Youth'), ('is_company','=', True)]}"/>-->
                    <!--  <field name="next_of_kin_relationship" attrs="{'invisible': ['|', ('contact_type','!=', 'Next of Kin'), ('is_company','=', True)]}"/>-->
                    <!--  <field name="host_site_id" widget="one2many_tags" attrs="{'invisible': [('is_company','=', True)]}"/>-->
                    <!--</field>-->

                    <field name="website" position="replace">
                        <field name="website" widget="url" placeholder="e.g. https://www.1stream.co.za" attrs="{'invisible': [('is_company','=', False)]}"/>
                    </field>
                    
                    <!--<xpath expr="//h1/field[@id='individual']" position="after">
                        <group>
                            <field name="cohorts_ids" widget="many2many_tags" attrs="{'invisible': [('is_company','=', False)]}" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            <field name="company_type" attrs="{'invisible': [('is_company','=', False)]}"/>
                        </group>
                    </xpath>-->
                    
                    <!--<xpath expr="//div[@class='oe_title mb24']/h1" position="after">-->
                    <!--    <div style="display: block;">-->
                    <!--        <div style="display: block;">-->
                    <!--            <field name="cohorts_ids" placeholder="Cohorts" widget="many2many_tags" attrs="{'invisible': [('is_company','=', False)]}" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>-->
                    <!--        </div>-->
                    <!--        <div style="display: block;">-->
                    <!--            <field name="company_type" attrs="{'invisible': [('is_company','=', False)]}"/>-->
                    <!--        </div>-->
                    <!--    </div>-->
                    <!--</xpath>-->
                    
                    <!-- Adding fields to the child form-->
                    <!--<field name="mobile" position="after">-->
                    <!--  <field name="email" context="{'gravatar_image': True}"/>-->
                    <!--</field>-->
                    <xpath expr="//field[@name='child_ids']//form//field[@name='name']" position="after">
                        <field name="youth_company_type" attrs="{'invisible' : [('type', '!=', 'other')]}"/>
                        <field name="female_ownership" widget="percentage" digits="[16, 2]" attrs="{'invisible': [('type', '!=', 'other')]}"/>
                        <field name="bee_level" attrs="{'invisible': [('type', '!=', 'other')]}"/>
                        <field name="business_size" attrs="{'invisible': [('type', '!=', 'other')]}"/>
                        <field name="sector_id" attrs="{'invisible': [('type', '!=', 'other')]}" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        <field name="capacity" attrs="{'invisible': [('type', '!=', 'other')]}"/>
                    </xpath>
                    
                    
                    <!-- <xpath expr="//field[@name='child_ids']//form//field[@name='phone']" position="attributes">
                        <attribute name="required">1</attribute>
                    </xpath> -->
                    
                    <!-- Remove the Sales tab -->
                    <xpath expr="//page[@name='sales_purchases']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                    <!-- Remove the title field -->
                    <xpath expr="//field[@name='title']" position="attributes">
                        <attribute name="invisible">1</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
