<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="youthwork_survey_question_form_view" model="ir.ui.view">
            <field name="name">survey.survey_question_form_view</field>
            <field name="model">survey.question</field>
            <field name="inherit_id" ref="survey.survey_question_form"/>
            <field name="arch" type="xml">
                <field name="question_type" position="after">
                    <field name="survey_type" attrs="{'invisible': [('question_type', '!=', 'user_id')]}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>