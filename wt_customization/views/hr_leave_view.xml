<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="youthwork_leave_form_view" model="ir.ui.view">
        <field name="name">leave_youtwork_view</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
        	<xpath expr="//field[@name='holiday_status_id']" position="replace">
        		<field name="holiday_status_id" force_save="1" domain="['|',('requires_allocation', '=', 'no'), ('has_valid_allocation', '=', True)]" context="{'employee_id':employee_id, 'default_date_from':date_from, 'default_date_to':date_to}" options="{'no_create': True, 'no_open': True, 'request_type':'leave'}"/>
        	</xpath>
        </field>
    </record>
</odoo>