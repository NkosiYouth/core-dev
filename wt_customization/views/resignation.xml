<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="wt_resignation" name="Resignation">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title pt40 pb40 o_colored_level" data-vcss="001"
                    data-snippet="s_title" data-name="Title" style="background-image: none;">
                    <div class="container s_allow_columns">
                        <h1 style="text-align: center;">
                            <font style="font-size: 62px;" class="o_default_snippet_text">Resignation
                                Submissions</font>
                        </h1>
                    </div>
                </section>
                <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001"
                    data-snippet="s_website_form" data-name="Form" style="background-image: none;">
                    <div class="container">
                        <form action="/website/form/" method="post" enctype="multipart/form-data"
                            class="o_mark_required" data-mark="*" data-pre-fill="true"
                            data-success-mode="redirect" data-success-page="/contactus-thank-you"
                            data-model_name="project.task">
                            <div class="s_website_form_rows row s_col_no_bgcolor">


                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                    data-type="char" data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label"
                                            style="width: 200px" for="oz5niwqbyfkq">


                                            <span class="s_website_form_label_content">Subject</span>


                                            <span class="s_website_form_mark"> *</span>
                                        </label>
                                        <div class="col-sm">

                                            <input type="text"
                                                class="form-control s_website_form_input"
                                                name="name" required="true" value="" placeholder=""
                                                id="oz5niwqbyfkq" data-fill-with="undefined" />


                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                    data-type="email" data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label "
                                            style="width: 200px" for="opfd8ox1b6kh">


                                            <span class="s_website_form_label_content">Your Email</span>


                                            <span class="s_website_form_mark"> *</span>
                                        </label>
                                        <div class="col-sm">

                                            <input type="email"
                                                class="form-control s_website_form_input"
                                                name="email_from" required="true" value=""
                                                placeholder="" id="opfd8ox1b6kh"
                                                data-fill-with="email" />


                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12" data-type="many2one"
                                    data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label "
                                            style="width: 200px" for="o5ktxxcw2gqm">


                                            <span class="s_website_form_label_content">Youth</span>
                                            <span class="s_website_form_mark"> *</span>


                                        </label>
                                        <div class="col-sm">
                                            <t t-set="resignation_youths"
                                                t-value="request.env['hr.employee'].sudo().search([])" />

                                            <select class="form-select s_website_form_input"
                                                name="employee_id" id="o5ktxxcw2gqm" style="" required="">
                                                <option value="" selected="selected">Select</option>
                                                <t t-foreach="resignation_youths" t-as="youth">

                                                    <option t-att-value="youth.id">
                                                        <t t-esc="youth.name" />
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12" data-type="many2one"
                                    data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label "
                                            style="width: 200px" for="o37nmfmmbhdl">


                                            <span class="s_website_form_label_content">Office</span>
                                            <span class="s_website_form_mark"> *</span>

                                        </label>
                                        <div class="col-sm">
                                            <t t-set="offices"
                                                t-value="request.env['office.office'].sudo().search([])" />
                                            <select class="form-select s_website_form_input"
                                                name="office_id" id="o37nmfmmbhdl"
                                                style="">
                                                <option value="" selected="selected">Select</option>
                                                <t t-foreach="offices" t-as="office" >
                                                    <option t-att-value="office.id"
                                                        >
                                                        <t t-esc="office.name" />
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12 col-lg-5"
                                    data-type="date" data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label "
                                            style="width: 200px" for="oah7v4046qrs">


                                            <span class="s_website_form_label_content">Resignation
                                                Date</span>


                                        </label>
                                        <div class="col-sm">


                                            <div class="s_website_form_date input-group date"
                                                id="datepicker07998415837112649"
                                                data-target-input="nearest">
                                                <input type="text"
                                                    class="form-control datetimepicker-input s_website_form_input"
                                                    data-target="#datepicker07998415837112649"
                                                    name="resignation_date" placeholder=""
                                                    id="oah7v4046qrs" data-fill-with="undefined" />
                                                <div class="input-group-text"
                                                    data-target="#datepicker07998415837112649"
                                                    data-toggle="datetimepicker">
                                                    <i class="fa fa-calendar" />
                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12 s_website_form_required"
                                    data-type="selection" data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label class=" col-sm-auto s_website_form_label "
                                            style="width: 200px" for="ou0n7fv1gwr">


                                            <span class="s_website_form_label_content">Reason for
                                                Resignation</span>

                                            <span class="s_website_form_mark"> *</span>


                                        </label>
                                        <div class="col-sm">


                                            <div
                                                class="row s_col_no_resize s_col_no_bgcolor s_website_form_multiple"
                                                data-name="reason_for_resignation"
                                                data-display="vertical">


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr0"
                                                            name="reason_for_resignation"
                                                            value="Better Job Opportunity"
                                                            required="1" data-fill-with="undefined" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr0">
                                                            Better Job Opportunity
                                                        </label>
                                                    </div>
                                                </div>


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr1"
                                                            name="reason_for_resignation"
                                                            value="Family Reasons" required="1" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr1">
                                                            Family Reasons
                                                        </label>
                                                    </div>
                                                </div>


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr2"
                                                            name="reason_for_resignation"
                                                            value="Personal Reasons" required="1" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr2">
                                                            Personal Reasons
                                                        </label>
                                                    </div>
                                                </div>


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr3"
                                                            name="reason_for_resignation"
                                                            value="Health Reasons" required="1" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr3">
                                                            Health Reasons
                                                        </label>
                                                    </div>
                                                </div>


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr4"
                                                            name="reason_for_resignation"
                                                            value="Furthering Studies" required="1" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr4">
                                                            Furthering Studies
                                                        </label>
                                                    </div>
                                                </div>


                                                <div class="radio col-12 ">
                                                    <div class="form-check">
                                                        <input type="radio"
                                                            class="s_website_form_input form-check-input"
                                                            id="ou0n7fv1gwr5"
                                                            name="reason_for_resignation"
                                                            value="Starting My Own Business"
                                                            required="1" />
                                                        <label
                                                            class="form-check-label s_website_form_check_label"
                                                            for="ou0n7fv1gwr5">
                                                            Starting My Own Business
                                                        </label>
                                                    </div>
                                                </div>


                                            </div>


                                        </div>
                                    </div>
                                </div>
                                <div data-visibility-condition="" data-visibility-between=""
                                    class="s_website_form_field mb-3 col-12" data-type="binary"
                                    data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label class=" col-sm-auto s_website_form_label "
                                            style="width: 200px" for="oqp6k43ume1q">


                                            <span class="s_website_form_label_content">Resignation
                                                Letter</span>
                                            <span class="s_website_form_mark"> *</span>


                                        </label>
                                        <div class="col-sm">

                                            <input type="file"
                                                class="form-control s_website_form_input"
                                                name="resignation_letter" id="oqp6k43ume1q"
                                                data-fill-with="undefined" required="true"/>


                                        </div>
                                    </div>
                                </div>


                                <div
                                    class="s_website_form_field mb-3 col-12    s_website_form_dnone"
                                    data-name="Field">
                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                        <label
                                            class="col-form-label col-sm-auto s_website_form_label "
                                            style="width: 200px">


                                            <span class="s_website_form_label_content" />


                                        </label>
                                        <div class="col-sm">

                                            <input type="hidden"
                                                class="form-control s_website_form_input"
                                                name="project_id" value="64" />


                                        </div>
                                    </div>
                                </div>

                                <div class="mb-0 py-2 col-12 s_website_form_submit"
                                    data-name="Submit Button">
                                    <div style="width: 200px;" class="s_website_form_label" />
                                    <a href="#" role="button"
                                        class="btn btn-primary btn-lg s_website_form_send o_default_snippet_text">
                                        Submit</a>
                                    <span id="s_website_form_result" />
                                </div>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
