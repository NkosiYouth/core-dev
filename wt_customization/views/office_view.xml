<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="youthwork_office_form_view" model="ir.ui.view">
            <field name="name">office.form.view</field>
            <field name="model">office.office</field>
            <field name="arch" type="xml">
                <form string="Office">
                    <sheet>
                        <group>
                            <group>
                            	<field name="name"/>
                            	<field name="user_ids" widget="many2many_tags"/>
                            	<field name="team_ids" widget="many2many_tags"/>
                            	<field name="province_id"/>
                            	<field name="office_type"/>
                            </group> 
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="youthwork_office_tree_view" model="ir.ui.view">
            <field name="name">office.tree.view</field>
            <field name="model">office.office</field>
            <field name="arch" type="xml">
                <tree >
                    <field name="name"/>
                    <field name="province_id"/>
                    <field name="user_ids" widget="many2many_tags"/>
                	<field name="team_ids" widget="many2many_tags"/>
                	<field name="office_type"/>
                </tree>
            </field>
        </record>
        <record id="youthwork_office_action" model="ir.actions.act_window">
            <field name="name">Office</field>
            <field name="res_model">office.office</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new Journey
                </p>
            </field>
        </record>

        <menuitem id="office_config" 
            name="Office" 
            action="wt_customization.youthwork_office_action" 
            parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu" 
            sequence="10"/>
    </data>
</odoo>