<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms.marketing</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="SMS Marketing" string="SMS Marketing" data-key="sms_marketing">
                  <h2>SMS Marketing</h2>
                    <div class="row mt16 o_settings_container" name="managa_mail_campaigns_setting_container">
                        <div class="o_setting_box col-12" title="This tool is advised if your marketing campaign is composed of several emails.">
                            <div class="">
                                <label for="group_mass_mailing_campaign"/>
                                <div class="text-muted">
                                    Simcloud Token
                                </div>
                            </div>
                            <div class="" title="This is useful if your marketing campaigns are composed of several emails.">
                                <field name="simcloud_token"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>