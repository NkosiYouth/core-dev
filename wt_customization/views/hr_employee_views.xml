<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_employee_filter_extended" model="ir.ui.view">
            <field name="name">view.employee.filter.extended</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department_id']" position="replace">
                    <field name="user_roles_id" enable_counters="1" select="multi"/>
                    <field name="host_site_province_id" string="Province" enable_counters="1" select="multi"/>
                    <field name="funder_id" enable_counters="1" select="multi"/>
                    <field name="cohort_id" enable_counters="1" select="multi"/>
                </xpath>
                
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Adding a Group By filter for user roles -->
                <xpath expr="//filter[@name='my_team']" position="after">
                    <filter name="group_state" string="Province" context="{'group_by': 'host_site_province_id'}"/>
                </xpath>

                <!-- Making existing filters invisible -->
                <xpath expr="//filter[@name='my_department']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='my_team']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='message_needaction']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='is_absent']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='newly_hired_employee']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Adding new filters -->
                <xpath expr="//filter[@name='my_team']" position="after">
                    <field name="user_roles_id" filter_domain="[('user_roles_id', 'ilike', self)]"/>
                    <field name="funder_id" filter_domain="[('funder_id', 'ilike', self)]"/>
                    <field name="cohort_id" filter_domain="[('cohort_id', 'ilike', self)]"/>
                    <filter name="all_user" string="All Users" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                    <field name="departure_reason_id" filter_domain="[('departure_reason_id', 'ilike', self)]"/>
                </xpath>

                <!-- Adding Group By Options -->
                <xpath expr="//group" position="inside">
                    <filter name="group_by_user_role" string="User Roles" context="{'group_by': 'user_roles_id'}"/>
                    <filter name="group_by_funder" string="Funder" context="{'group_by': 'funder_id'}"/>
                    <filter name="group_by_cohort" string="Cohort" context="{'group_by': 'cohort_id'}"/>
                </xpath>

                <!-- Customizing the Search Bar -->
                <xpath expr="//search" position="attributes">
                    <attribute name="string">Search by User Role, Funder, Cohort</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_employee_inherit_form_view2" model="ir.ui.view">
            <field name="name">hr_employee_youtwork_view2</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_contract.hr_hr_employee_view_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='contract_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
        <record id="hr_employee_inherit_form_view" model="ir.ui.view">
            <field name="name">hr_employee_youtwork_view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="mobile_phone" position="attributes">
                    <attribute name="string">Primary Number</attribute>
                </field>
                <!--<field name="mobile_phone" position="after">-->
                <!--  <field name="phone" widget="phone"/>-->
                <!--</field>-->
                <xpath expr="//sheet/group/group/field[@name='company_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> 
                <field name="work_phone" position="attributes">
                    <attribute name="string">Secondary Number</attribute>
                </field>
                <field name="department_id" position="after">
                    <field name="contract_id" readonly="1"/>
                </field>
                <field name="work_email" position="attributes">
                    <attribute name="string">Email Address</attribute>
                </field>
                <field name="mobile_phone" position="before">
                    <field name="user_roles_id" readonly="1" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                    <field name="absorption_indication"/>
                </field>
                <field name="parent_id" position="after">
                    <field name="x_contract_month" readonly="1" attrs="{'invisible': [('user_roles_id', '!=', 2)]}"/>
                </field>
                <field name="x_contract_month" position="after">
                    <field name="active" readonly="1" attrs="{'invisible': [('user_roles_id', '!=', 2)]}"/>
                </field>
                <xpath expr="//field[@name='category_ids']" position="attributes">
                    <attribute name="options">{'color_field': 'color', 'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
                <xpath expr="//group/field[@name='job_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                
                <xpath expr="//page[@name='public']" position="before">
                    <page name="dashboard" string="Dashboard">
                        <field name="dashboard"/>
                    </page>
                </xpath>
                
                <xpath expr="//field[@name='category_ids']" position="attributes">
                    <attribute name="attrs">{'invisible': [('has_hr_issues', '=', False)]}</attribute>
                </xpath>
                
                
                    <!-- Work Information-->
                <xpath expr="//div[@id='o_work_employee_main']/group" position="replace"/>
                <xpath expr="//div[@id='o_work_employee_main']/group" position="before">
                    <group string="Funder Info">
                        <field name="has_hr_issues" invisible="1"/>
                        <field name="funder_id" readonly="1" domain="[('is_company', '=', True)]"/>
                        <field name="cohort_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        <field name="payroll_type" readonly="1"/>
                        <field name="work_contact_id"/>
                    </group>
                    <group string="Host Site Info">
                        <!--<field name="host_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>-->
                        <field name="host_site_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        <field name="host_site_province_id" readonly="1" string="Province"/>
                    <field name="sector_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                    <field name="partner_id" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                    </group>
                </xpath>
                
                <!-- Registers-->
                <xpath expr="//page[@name='public']" position="after">
                    <page name="registers" string="Weekly Registers" attrs="{'invisible': [('user_roles_id', '=', 3)]}">
                        <field name="register_ids">
                            <tree string="Registers" default_order="id desc" editable="bottom" create="false" decoration-warning="stage_id == 1">
                            <field name="name" string="Week" readonly="1"/>
                            <field name="project_id" invisible="0"/>
                            <field name="company_id" invisible="1"/>
                            <field name="stage_id" readonly="0" string="Status"/>
                            <!-- <field name="weekly_tasks_ids" readonly="1"/> -->
                            <button type="object" style="color:#000000; background-color:#F5A94E; width: 100px;" name="get_formview_action" string="Open" icon="fa-edit"/>
                        </tree>
                        </field>
                    </page>

                    <page name="survey_user_inputs" string="Surveys">
                        <field name="survey_ids">
                            <tree string="Surveys" decoration-muted="test_entry == True" create="false">
                                <field name="create_date"/>
                                <field name="survey_id"/>
                                <field name="nickname" optional="hide"/>
                                <field name="partner_id" optional="show"/>
                                <field name="email" optional="show"/>
                                <field name="attempts_number"/>
                                <field name="deadline"/>
                                <field name="test_entry" invisible="True"/>
                                <field name="scoring_success"/>
                                <field name="scoring_percentage"/>
                                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'new'" decoration-info="state == 'in_progress'"/>
                            </tree>                      
                        </field>
                    </page>
                </xpath>
                
                <!-- Site Visits-->
                <xpath expr="//page[@name='public']" position="after">
                <page name="site_visits" string="Site Visits">
                    <!--<group>
                        <field name="site_visit_computed_field" groups="base.group_no_one"/>
                        <field name="latest_site_visit_date"/>
                        <field name="site_visit_user_id"/>
                    </group>-->
                    <button type="object" name="open_youth_visit_task" class="oe_highlight" string="Capture New Site Visit" style="margin-bottom:8px;"/>
                    <field name="site_visit_ids" context="{'default_employee_id': active_id}">
                        <tree string="Site Visits" default_order="id desc" editable="bottom" create="false" domain="[('project_id','=',12)]">
                            <field name="name"/>
                            <field name="site_visit_date" readonly="1"/>
                            <field name="date_deadline" string="Visit Deadline"/>
                            <!--<field name="user_ids"/>-->
                            <field name="stage_id" readonly="1"/>
                            <button type="object" style="color:#000000; background-color:#F5A94E; width: 100px;" name="get_formview_action" string="Open" icon="fa-edit"/>
                        </tree>    
                    </field>
                </page>
                
                <page name="session_tasks" string="Session Tasks" attrs="{'invisible': [('user_roles_id', '=', 3)]}">
                    <field name="session_task_ids" context="{'default_employee_id': active_id}">
                        <tree string="Session Tasks" default_order="id desc" editable="bottom" create="false" domain="[('project_id','=', 26)]">
                            <field name="name"/>
                            <field name="date_deadline" string="Visit Deadline"/>
                            <field name="stage_id" readonly="1"/>
                            <button type="object" style="color:#000000; background-color:#F5A94E; width: 100px;" name="get_formview_action" string="Open" icon="fa-edit"/>
                        </tree>    
                    </field>
                </page>
                </xpath>
                
                <!-- Next of Kin-->
                <xpath expr="//field[@name='emergency_contact']" position="replace">
                            <field name="next_of_kin_ids" mode="kanban">
                                <kanban>
                                    <field name="name"/>
                                    <field name="next_of_kin_relationship"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                                                <div class="oe_kanban_details">
                                                    <div class="o_kanban_record_top">
                                                        <div class="o_kanban_record_headings">
                                                            <strong class="o_kanban_record_title">
                                                                <field name="name"/>
                                                            </strong>
                                                            <p>
                                                            <label for="next_of_kin_relationship" string="Relation: "/>
                                                            <field name="next_of_kin_relationship"/>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="oe_kanban_content">
                                                        <div class="o_kanban_record_bottom">
                                                            <div class="oe_kanban_bottom_left">
                                                                <!-- Add any additional info or icons -->
                                                            </div>
                                                            <div class="oe_kanban_bottom_right">
                                                                <!-- Optionally add more fields or controls -->
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                </xpath>
                
                <!-- Private Information-->
                <field name="gender" position="after">
                    <field name="race"/>
                    <field name="disabled"/>
                </field>
                
                <!-- HR Issues-->
                <xpath expr="//page[@name='site_visits']" position="after">
                    <page name="hr_issues" string="HR Issues">
                        <!--<group>
                        <field name="site_visit_computed_field" groups="base.group_no_one"/>
                        <field name="latest_site_visit_date"/>
                        <field name="site_visit_user_id"/>
                        </group>-->
                        <button type="object" name="open_hr_issue_task" class="oe_highlight" string="Capture New HR Issue" style="margin-bottom:8px;"/>
                        <field name="hr_issues_ids" context="{'default_youth_id': active_id}">
                            <tree string="HR Issues" default_order="id desc" editable="bottom" create="false">
                                <field name="issue_type" readonly="1"/>
                                <!--<field name="project_id"/>-->
                                <field name="issue_priority" readonly="1"/>
                                <field name="stage_id" readonly="1"/>
                                <button type="object" style="color:#000000; background-color:#F5A94E; width: 100px;" name="get_formview_action" string="Open" icon="fa-edit"/>
                            </tree>    
                        </field>
                    </page>
                </xpath>
                
                <!-- Journey -->
                <xpath expr="//page[@name='hr_issues']" position="after">
                    <page name="journey_new" string="Journey" attrs="{'invisible': [('user_roles_id', '=', 3)]}">
                    
                        <field name="journey_id" domain="[('journey', '=', True)]" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        <field name="journey_ids" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}">
                        <tree string="Journeys" default_order="id desc" delete="false" create="false" decoration-muted="is_closed == True">
                            <field name="project_id"/>
                            <field name="name"/>
                            <field name="stage_id"/>
                            <field name="is_closed" invisible="1"/>
                            <button type="object" style="color:#000000; background-color:#F5A94E; width: 100px;" name="get_formview_action" string="Open" icon="fa-edit"/>
                        </tree>
                        </field>
                    </page>
                </xpath>
                
                <!-- Remove Work Permit Section -->
                <xpath expr="//group/field[@name='visa_no']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='permit_no']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='visa_expire']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='work_permit_expiration_date']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='work_permit_name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='has_work_permit']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/separator[@name='has_work_permit']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <!-- Remove Select Citizenship Fields -->
                <xpath expr="//group/field[@name='passport_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='place_of_birth']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/field[@name='country_of_birth']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//group/field[@name='coach_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//div[@name='div_km_home_work']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="options">{'no_create': True}</attribute>
                    <attribute name="domain">[('user_roles_id', '!=', 2)]</attribute>
                </xpath>
                
                <!-- <xpath expr="//button[@name='932']" position="attributes">
                    <attribute name="attrs">{'invisible': [('user_roles_id', '!=', 4)]}</attribute>
                </xpath> -->
                
                <!-- <xpath expr="//button[@name='648']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> -->
                
                <xpath expr="//field[@name='job_title']" position="replace">
                    <field name="job_id" string="Job Position" placeholder="Job Description" options="{'no_create': True}"/>
                </xpath>
                
                <xpath expr="//field[@name='resource_calendar_id']/ancestor::group" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='lang']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='km_home_work']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='country_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='birthday']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <!-- <xpath expr="//field[@name='marital']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> -->
                
                <xpath expr="//field[@name='children']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='pin']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_employee_inherit_kanban_view" model="ir.ui.view">
            <field name="name">youth.employee.kanban</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//ul" position="replace">
                    <ul>
                        <li t-if="record.user_roles_id.raw_value"><field name="user_roles_id" widget="many2one_tags"/></li>
                        <li t-if="record.host_site_id.raw_value"><field name="host_site_id"/></li>
                        <li t-if="record.cohort_id.raw_value"><field name="cohort_id"/></li>
                    </ul>
                </xpath>
                  
                <xpath expr="//span[contains(@class, 'o_kanban_record_subtitle')]" position="replace">
                    <span t-if="record.job_id.raw_value" class="o_kanban_record_subtitle">
                        <field name="job_id"/>
                    </span>
                </xpath>
            </field>
        </record>
        <menuitem
            id="hr.menu_hr_employee_payroll"
            name="Users"
            parent="hr.menu_hr_root"
            groups="hr.group_hr_user"
            sequence="3"/>

        <menuitem
            id="hr.menu_hr_root"
            name="Users"
            groups="hr.group_hr_manager,hr.group_hr_user,base.group_user"
            web_icon="hr,static/description/icon.svg"
            sequence="185"/>

        <menuitem
            id="hr.menu_hr_employee_user"
            name="Users"
            action="hr.open_view_employee_list_my"
            parent="hr.menu_hr_employee_payroll"
            sequence="1"/>

        <record id="hr.open_view_employee_list_my" model="ir.actions.act_window">
            <field name="name">Users</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">kanban,tree,form,activity</field>
            <field name="domain">[]</field>
            <field name="context">{'chat_icon': True}</field>
            <field name="view_id" eval="False"/>
            <field name="search_view_id" ref="hr.view_employee_filter"/>
            <field name="help" type="html">
             <p class="o_view_nocontent_smiling_face">
               Add a new employee
             </p><p>
               With just a quick glance on the Odoo employee screen, you
               can easily find all the information you need for each person;
               contact data, job position, availability, etc.
             </p>
            </field>
        </record>
    </data>
</odoo>