<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="wt_job_vacancies_page" name="Job Vaccancies">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001"
                    data-snippet="s_website_form" data-name="Form" style="background-image: none;">
                    <div class="container">
                        <div id="form_container">
                            <form action="/website/form/" method="post"
                                enctype="multipart/form-data" class="o_mark_required vaccancie_form"
                                data-mark="*" data-pre-fill="true" data-success-mode="redirect"
                                data-success-page="/contactus-thank-you"
                                data-model_name="project.task" id="vaccancy_1">
                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                    <h3 class="text-center h1_class_job d-none">Job 1</h3>
                                    <div data-visibility-condition="" data-visibility-between=""
                                        class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                        data-type="char" data-name="Field">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label"
                                                style="width: 200px" for="opnau1zf7sx">


                                                <span class="s_website_form_label_content">Job Title</span>


                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <div class="col-sm">

                                                <input type="text"
                                                    class="form-control s_website_form_input"
                                                    name="name" required="true" value=""
                                                    placeholder="" id="opnau1zf7sx"
                                                    data-fill-with="undefined" />


                                            </div>
                                        </div>
                                    </div>
                                    <div data-visibility-condition="" data-visibility-between=""
                                        class="s_website_form_field mb-3 col-12 s_website_form_model_required email_for_job"
                                        data-type="email" data-name="Field">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label "
                                                style="width: 200px" for="oz8yu39d3ahc">


                                                <span class="s_website_form_label_content">Email</span>


                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <div class="col-sm">

                                                <input type="email"
                                                    class="form-control s_website_form_input"
                                                    name="email_from" required="true" placeholder=""
                                                    id="oz8yu39d3ahc" data-fill-with="email" />


                                            </div>
                                        </div>
                                    </div>
                                    <div class="s_website_form_field mb-3 col-12"
                                        data-type="many2one" data-name="Field"
                                        data-visibility-condition="" data-visibility-between="">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label "
                                                style="width: 200px" for="o9qgzkgbkude">


                                                <span class="s_website_form_label_content">Host Site</span>


                                            </label>
                                            <div class="col-sm">

                                                <select class="form-select s_website_form_input"
                                                    name="host_site_id" id="o9qgzkgbkude" style="">

                                                    <option value="138" selected="selected">Test
                                                        Host Site 6</option>

                                                    <option value="44">Test Site</option>

                                                    <option value="14">Test Youth</option>

                                                    <option value="136">Warlock Public</option>

                                                    <option value="40">YashWarlock</option>

                                                    <option value="41">YashWarlock HostSite</option>

                                                </select>


                                            </div>
                                        </div>
                                    </div>
                                    <div data-visibility-condition="" data-visibility-between=""
                                        class="s_website_form_field mb-3 col-12 s_website_form_required"
                                        data-type="integer" data-name="Field">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label "
                                                style="width: 200px" for="o950kttlxxzo">


                                                <span class="s_website_form_label_content">Number Of
                                                    Vacancies</span>

                                                <span class="s_website_form_mark"> *</span>


                                            </label>
                                            <div class="col-sm">

                                                <input type="number"
                                                    class="form-control s_website_form_input"
                                                    name="vacancies" step="1" required="1"
                                                    value="" placeholder="" id="o950kttlxxzo"
                                                    data-fill-with="undefined" />


                                            </div>
                                        </div>
                                    </div>
                                    <div
                                        class="s_website_form_field mb-3 col-12 s_website_form_required s_website_form_field_hidden"
                                        data-type="many2one" data-name="Field"
                                        data-visibility-condition="" data-visibility-between="">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label "
                                                style="width: 200px" for="o6h6h786jxho">


                                                <span class="s_website_form_label_content">Youth</span>
                                                <span class="s_website_form_mark"> *</span>
                                            </label>
                                            <div class="col-sm">
                                                <select class="form-select s_website_form_input" name="employee_id" required="1" id="o6h6h786jxho">
                                                    <t t-foreach="request.env['hr.employee'].sudo().search([])" t-as="employee">
                                                        <option t-att-value="employee.id" t-esc="employee.name" 
                                                            t-if="request.env.user.employee_id.id == employee.id" 
                                                            selected="selected">
                                                        </option>
                                                        <option t-att-value="employee.id" t-esc="employee.name"
                                                            t-if="request.env.user.employee_id.id != employee.id">
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                        </div>
                                    </div>


                                    <div
                                        class="s_website_form_field mb-3 col-12    s_website_form_dnone"
                                        data-name="Field">
                                        <div class="row s_col_no_resize s_col_no_bgcolor">
                                            <label
                                                class="col-form-label col-sm-auto s_website_form_label "
                                                style="width: 200px">


                                                <span class="s_website_form_label_content" />


                                            </label>
                                            <div class="col-sm">

                                                <input type="hidden"
                                                    class="form-control s_website_form_input"
                                                    name="project_id" value="65" />


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="mb-0 py-2 col-12 s_website_form_submit"
                            data-name="Submit Button">
                            <div style="width: 200px;" class="s_website_form_label" />
                            <a href="#" role="button" class="mx-2 btn btn-success  add_job">
                                Add Job
                            </a>
                            <a href="#" role="button" class="btn btn-primary vaccancy_submit">Submit</a>
                            <a href="#" id="remove_job" role="button"
                                class="my-2 mx-2 btn btn-danger d-none">
                                Remove Job
                            </a>
                            <span id="s_website_form_result" />
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>