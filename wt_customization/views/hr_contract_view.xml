<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_contract_inherit_form_view" model="ir.ui.view">
            <field name="name">hr_contract_youtwork_view</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <field name="employee_id" position="after">
                    <field name="cohort_id" readonly="1"/>        
                </field>
                <field name="contract_type_id" position="after">
                    <field name="contract_signed"/>
                </field>
                <field name="hr_responsible_id" position="after">
                    <field name="month_into_program" readonly="1"/>
                        
                    </field>
            </field>
        </record>
    </data>
</odoo>