<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="youthwork_survey_form_view" model="ir.ui.view">
            <field name="name">survey.survey_youtwork_view</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <!-- <field name="survey_type"/> -->
                    <!-- <field name="youth_user_id" options="{'no_create_edit': True}"/> -->
                    <field name="journey_id"/>
                    <field name="cohort_id"/>
                    <field name="host_site_id"/>
                    <field name="partner_id"/>
                </xpath>
            </field>
        </record>

        <record id="youthwork_survey_user_input_line_view_form" model="ir.ui.view">
            <field name="name">survey.user.input.line.view.form</field>
            <field name="model">survey.user_input.line</field>
            <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='value_char_box']" position="before">
                    <field name="value_user_id" colspan="2" attrs="{'invisible': [('answer_type','!=','user_id')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>