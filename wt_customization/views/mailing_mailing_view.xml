<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="youthwork_view_mail_mass_mailing_form" model="ir.ui.view">
            <field name="name">mailing.mailing.form.youtwork</field>
            <field name="model">mailing.mailing</field>
            <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//group[hasclass('o_mass_mailing_mailing_group')]" position="after">
            		<group>
            			<field name="is_simcloud_api"/>
            			<field name="token" invisible="1"/>
            		</group>
            	</xpath>
            </field>
        </record>
</odoo>