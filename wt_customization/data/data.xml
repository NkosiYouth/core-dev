<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="host_partner_site_menu" model="website.menu">
            <field name="name">Host Site &amp; Partner</field>
            <field name="url">/host-site-partner-1</field>
            <field name="sequence">30</field>
        </record>
        <record id="wt_host_site_youth_application" model="website.menu">
            <field name="name">Youth Application</field>
            <field name="url">/youth-appication</field>
            <field name="sequence">40</field>
        </record>
        <record id="wt_hr_issues" model="website.menu">
            <field name="name">HR Issues</field>
            <field name="url">/hr-issues</field>
            <field name="sequence">50</field>
        </record>
        <record id="wt_job_vacancies" model="website.menu">
            <field name="name">Job Vacancies</field>
            <field name="url">/job-vacancies</field>
            <field name="sequence">60</field>
        </record>
        
        <record id="wt_resignations" model="website.menu">
            <field name="name">Resignations</field>
            <field name="url">/resignations</field>
            <field name="sequence">70</field>
        </record>
        <record id="wt_youth_leave_button" model="website.menu">
            <field name="name">Create Leave</field>
            <field name="url">/create-leave</field>
            <field name="sequence">40</field>
        </record>

        <record id="ir_cron_create_daily_task" model="ir.cron">
            <field name="name">Create Daily Register Task</field>
            <field name="model_id" ref="model_project_task"/>
            <field name="state">code</field>
            <field name="code">model.create_daily_task()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
        </record>

        <record id="ir_cron_create_weekly_task" model="ir.cron">
            <field name="name">Create Weekly Register Task</field>
            <field name="model_id" ref="model_project_task"/>
            <field name="state">code</field>
            <field name="code">model.create_weekly_register_task()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active">False</field>
        </record>

    </data>
</odoo>