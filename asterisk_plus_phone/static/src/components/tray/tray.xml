<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <div t-name="asterisk_plus_phone.menu" class="o-dropdown dropdown o-dropdown--no-caret" owl="1">
        <button type="button" t-attf-class="dropdown-toggle toggle-phone {{state.inCall ? 'busy' : 'available'}}" tabindex="0" aria-expanded="false" title="Toggle Phone" t-on-click="_onClick" t-on-contextmenu="_onContextmenu">
            <i aria-label="Toggle Phone" class="fa fa-fw fa-phone" role="img"/>
        </button>

        <button t-if="!state.isDisplay and state.inCall" class="hang-up-popup" title="HangUp" t-on-click="_onClickHangUp">
            <i aria-label="HangUp" class="icon-call_end reject-call"/>
        </button>

        <div id="rMenu" t-ref="rMenu" t-attf-class="rmenu d-flex flex-column{{state.isContextMenu ? '' : ' hide'}}" tabindex="-1">
            <div class="d-flex flex-row">
                <span t-on-click="_onClickBugReport">Bug Report</span>
            </div>
        </div>

        <div t-attf-class="modal{{state.isReportModal ? ' show': ''}}" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Phone Bug Report</h5>
                    </div>
                    <div class="modal-body">
                        <textarea t-ref="bugDescription" rows="6" cols="50" placeholder="Bug description (required)"/>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary"  t-on-click="_onClickSendReport">Send Report</button>
                        <button type="button" class="btn btn-secondary" t-on-click="_onClickCloseReport">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</templates>